<?xml version="1.0" encoding="utf-8"?>
<!--
  Packaged identity for RADHA SHELL.

  Only needed for features that WinRT refuses to serve an unpackaged process:

    * userNotificationListener  — read toasts raised by other apps (notification mirroring)
    * runFullTrust              — required by any desktop (WinUI 3 / desktop-bridge) package

  Build with:  dotnet publish src/Radha.App -p:RadhaPackaged=true -p:Platform=x64
  Unpackaged builds (the default) ignore this file and report those features as unavailable.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="RadhaShell.Desktop" Publisher="CN=RADHA SHELL" Version="0.1.0.0" />

  <Properties>
    <DisplayName>RADHA SHELL</DisplayName>
    <PublisherDisplayName>rreon633-design</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="RadhaShell" Executable="Radha.App.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="RADHA SHELL" Description="Native Windows shell"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.appExecutionAlias" Executable="Radha.App.exe" EntryPoint="Windows.FullTrustApplication">
          <uap:AppExecutionAlias>
            <uap:ExecutionAlias Alias="radha-shell.exe" />
          </uap:AppExecutionAlias>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Restricted capability: request it in Partner Center before shipping via the Store. -->
    <rescap:Capability Name="userNotificationListener" />
  </Capabilities>
</Package>
