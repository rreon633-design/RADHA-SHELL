<Project Sdk="Microsoft.NET.Sdk">

  <!-- RADHA SHELL — WinUI 3 presentation layer.
       Windows-only. Build with:  dotnet build src/Radha.App/Radha.App.csproj -c Release
       Requires the Windows App SDK runtime (or WindowsAppSDKSelfContained=true). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Radha.App</RootNamespace>
    <!-- The shipped file is RadhaShell.exe: one executable a user can double-click. The namespace
         stays Radha.App, and the packaged alias in Package.appxmanifest matches. -->
    <AssemblyName>RadhaShell</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- opt-in packaged identity: dotnet publish -p:RadhaPackaged=true
         Needed only for toasts mirroring (userNotificationListener). Default stays unpackaged. -->
    <WindowsPackageType Condition="'$(RadhaPackaged)' == 'true'">MSIX</WindowsPackageType>
    <EnableMsixTooling Condition="'$(RadhaPackaged)' == 'true'">true</EnableMsixTooling>
    <AppxManifest Condition="'$(RadhaPackaged)' == 'true'">Package.appxmanifest</AppxManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\radha.ico</ApplicationIcon>
    <!-- An unpackaged WinUI app resolves App.xaml through resources.pri and nothing else: the
         resource loader looks for that exact file name next to the module. MSBuild instead names
         the package resource index after $(TargetName), and the target name here is RadhaShell, so
         the default produced RadhaShell.pri — a file no loader ever opens. The result was a window
         that never appeared and an exit code nobody saw. See microsoft/microsoft-ui-xaml#10856. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <!-- Program.cs owns Main so the selftest switch can run before any XAML exists.
         (Note for future edits: a double hyphen is not legal inside an XML comment.) -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Single-file distribution: dotnet publish -p:RadhaSingleFile=true
       Not the default, because a single-file WinUI bundle is ~200 MB and local iteration should not
       pay for extracting it on every launch. -->
  <PropertyGroup Condition="'$(RadhaSingleFile)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WinRT activation resolves paths, so content is extracted rather than read from the bundle. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Halves the download. The cost is decompression into %TEMP% on first launch, which is
         paid once per version and is far cheaper than a 300 MB download for every user. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Required by Microsoft.WindowsAppSDK.SingleFile.targets: single-file needs MSIX tooling to
         generate the embedded resources.pri, and needs the undocked reg-free WinRT initialiser so
         activation does not look for an installed runtime. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- A shipped binary carries no symbols: they were ~50 MB of the bundle and buy the user
         nothing. CI still debugs the same code through the normal build configuration. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- A single-file bundle extracts everything to %TEMP%\.net\... on first launch. WinExe has no
       console, so anything that goes wrong before the first frame is invisible. These two
       properties keep the build honest instead of silent. -->
  <PropertyGroup Condition="'$(RadhaSingleFile)' == 'true'">
    <SmokeTestTimeoutSeconds Condition="'$(SmokeTestTimeoutSeconds)' == ''">90</SmokeTestTimeoutSeconds>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Radha.Core\Radha.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The C++ bridge is built by CMake and dropped here before publish, so the single-file bundle
       carries it. Absent on a machine without the native toolchain: the managed side then degrades
       to its labelled fallbacks instead of failing to build. -->
  <ItemGroup Condition="Exists('native\RadhaNative.dll')">
    <None Include="native\RadhaNative.dll" Link="RadhaNative.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
