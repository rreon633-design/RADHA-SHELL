<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RADHA SHELL design tokens.
         Colour roles are applied at runtime by ThemeViewModel; this file only holds
         typography, geometry and motion constants so views stay declarative. -->

    <FontFamily x:Key="RadhaFont">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="RadhaMono">Cascadia Code</FontFamily>

    <x:Double x:Key="RadhaRadiusLarge">28</x:Double>
    <x:Double x:Key="RadhaRadiusMedium">18</x:Double>
    <x:Double x:Key="RadhaRadiusSmall">11</x:Double>
    <x:Double x:Key="RadhaBarHeight">42</x:Double>

    <CornerRadius x:Key="RadhaCardCorner">22</CornerRadius>
    <CornerRadius x:Key="RadhaPillCorner">999</CornerRadius>
    <Thickness x:Key="RadhaCardPadding">14</Thickness>

    <!-- Typography -->
    <Style x:Key="RadhaDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RadhaFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiLight" />
        <Setter Property="CharacterSpacing" Value="-20" />
    </Style>

    <Style x:Key="RadhaTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RadhaFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="RadhaBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RadhaFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="RadhaLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RadhaFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <Style x:Key="RadhaMonoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RadhaMono}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Icon font: Material Symbols Outlined must be installed (see docs/INSTALL.md),
         otherwise Segoe MDL2 Assets is used as a graceful fallback. -->
    <Style x:Key="RadhaIcon" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="RadhaCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadhaCardCorner}" />
        <Setter Property="Padding" Value="{StaticResource RadhaCardPadding}" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#22FFFFFF" />
    </Style>

</ResourceDictionary>
