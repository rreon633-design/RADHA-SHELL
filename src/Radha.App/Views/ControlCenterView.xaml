<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Radha.App.Views.ControlCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{Binding State.Theme.SurfaceGlass}"
            BorderBrush="{Binding State.Theme.OutlineVariant}" BorderThickness="1"
            CornerRadius="28" Padding="14">
        <StackPanel Spacing="12">

            <Grid>
                <StackPanel>
                    <TextBlock Text="Control centre" FontSize="14" FontWeight="SemiBold"
                               Foreground="{Binding State.Theme.OnSurface}" />
                    <TextBlock Text="{Binding NetworkName}" FontSize="9"
                               Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="30" Height="30" Padding="0"
                        CornerRadius="10" BorderThickness="0"
                        Background="{Binding State.Theme.SurfaceContainerHigh}"
                        Command="{Binding State.CloseAllCommand}">
                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                </Button>
            </Grid>

            <!-- sliders -->
            <Border Background="{Binding State.Theme.SurfaceContainerHigh}" CornerRadius="18" Padding="12">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE767;" FontSize="13" Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"
                                Foreground="{Binding State.Theme.Primary}" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE706;" FontSize="13" Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness, Mode=TwoWay}"
                                Foreground="{Binding State.Theme.Primary}" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE720;" FontSize="13" Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Microphone, Mode=TwoWay}"
                                Foreground="{Binding State.Theme.Primary}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- tiles -->
            <ItemsRepeater ItemsSource="{Binding Tiles}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="104" MinItemHeight="70" ItemsStretch="Fill"
                                       MinColumnSpacing="8" MinRowSpacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnTileClick" Padding="10" CornerRadius="16" BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                Background="{Binding TileBrush}">
                            <StackPanel Spacing="5">
                                <Border Width="26" Height="26" CornerRadius="8" Background="{Binding IconBackground}">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="13" Foreground="{Binding IconBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="9.5" TextWrapping="Wrap"
                                           Foreground="{Binding LabelBrush}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- theme card -->
            <Border Background="{Binding State.Theme.SurfaceContainerHigh}" CornerRadius="18" Padding="12">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Dynamic theme" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{Binding State.Theme.OnSurface}" />
                        <TextBlock Text="Material 3" FontSize="8.5" HorizontalAlignment="Right"
                                   Foreground="{Binding State.Theme.Primary}" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Command="{Binding ToggleDarkCommand}" Width="34" Height="32"
                                Padding="0" CornerRadius="10" BorderThickness="0"
                                Background="{Binding State.Theme.PrimaryContainer}">
                            <FontIcon Glyph="&#xE793;" FontSize="13"
                                      Foreground="{Binding State.Theme.OnPrimaryContainer}" />
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Next wallpaper" FontSize="10" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" CornerRadius="10" BorderThickness="0"
                                Background="{Binding State.Theme.SurfaceContainerHighest}"
                                Foreground="{Binding State.Theme.OnSurface}"
                                Command="{Binding RefreshWallpaperCommand}" />
                        <Button Grid.Column="1" Content="Wallpaper picker" FontSize="10"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                CornerRadius="10" BorderThickness="0"
                                Background="{Binding State.Theme.SurfaceContainerHighest}"
                                Foreground="{Binding State.Theme.OnSurface}"
                                Command="{Binding State.ToggleLauncherCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
