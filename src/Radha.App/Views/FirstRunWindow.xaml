<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Radha.App.Views.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header + live preview of the bar -->
        <Grid Grid.Row="0" Margin="28,22,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Welcome to RADHA SHELL" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Set it up once. Everything here is editable later from the tray or the control centre."
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" MaxWidth="520" />
            </StackPanel>
            <Border Grid.Column="1" Width="210" Height="34" CornerRadius="10" VerticalAlignment="Top"
                    x:Name="PreviewBar" BorderThickness="1">
                <Grid Padding="8,0">
                    <TextBlock Text="RADHA" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                               x:Name="PreviewLogo" />
                    <TextBlock Text="10:07" HorizontalAlignment="Right" FontSize="10" VerticalAlignment="Center"
                               x:Name="PreviewClock" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- steps -->
            <StackPanel Spacing="6" Margin="0,4,12,0">
                <Button x:Name="Step1" Content="1 · Appearance" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="OnStepAppearance" />
                <Button x:Name="Step2" Content="2 · Bar" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="OnStepBar" />
                <Button x:Name="Step3" Content="3 · Behaviour" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="OnStepBehaviour" />
                <TextBlock Text="You can change all of it later." FontSize="10" Opacity="0.55"
                           TextWrapping="Wrap" Margin="2,10,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Column="1">
                <Grid>

                    <!-- step 1: appearance -->
                    <StackPanel x:Name="PageAppearance" Spacing="14">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Theme" FontWeight="SemiBold" />
                                <ComboBox x:Name="ModeBox" Header="Mode" Width="240" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Follow Windows" />
                                    <ComboBoxItem Content="Dark" />
                                    <ComboBoxItem Content="Light" />
                                </ComboBox>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Accent colour" FontSize="12" />
                                    <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="8" />
                                </StackPanel>
                                <ComboBox x:Name="VariantBox" Header="Palette variant" Width="240"
                                          HorizontalAlignment="Left" />
                                <ToggleSwitch x:Name="DarkPreviewSwitch" Header="Use dark surfaces"
                                              OnContent="Dark" OffContent="Light"
                                              Toggled="OnDarkPreviewToggled" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Shape and motion" FontWeight="SemiBold" />
                                <Slider x:Name="RoundingSlider" Header="Corner rounding" Minimum="0" Maximum="2"
                                        StepFrequency="0.05" Width="320" HorizontalAlignment="Left" />
                                <Slider x:Name="AnimationSlider" Header="Animation speed (0 = off)" Minimum="0"
                                        Maximum="2" StepFrequency="0.05" Width="320" HorizontalAlignment="Left" />
                                <Slider x:Name="ScaleSlider" Header="Interface scale" Minimum="0.8" Maximum="1.6"
                                        StepFrequency="0.05" Width="320" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- step 2: bar -->
                    <StackPanel x:Name="PageBar" Spacing="14" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="The bar" FontWeight="SemiBold" />
                                <ComboBox x:Name="PositionBox" Header="Position" Width="240" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Top" />
                                    <ComboBoxItem Content="Bottom" />
                                </ComboBox>
                                <Slider x:Name="HeightSlider" Header="Height" Minimum="28" Maximum="64"
                                        StepFrequency="1" Width="320" HorizontalAlignment="Left"
                                        ValueChanged="OnHeightChanged" />
                                <ToggleSwitch x:Name="AllDisplaysSwitch" Header="Show on every display"
                                              OnContent="Every display" OffContent="Primary only" />
                                <ToggleSwitch x:Name="TraySwitch" Header="Tray icon (the way back to these settings)"
                                              OnContent="On" OffContent="Off" />
                                <ToggleSwitch x:Name="AutoHideSwitch" Header="Hide the bar until the pointer reaches it"
                                              OnContent="Auto-hide" OffContent="Always visible" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Workspaces and clock" FontWeight="SemiBold" />
                                <Slider x:Name="WorkspaceCountSlider" Header="Workspaces" Minimum="1" Maximum="12"
                                        StepFrequency="1" Width="320" HorizontalAlignment="Left" />
                                <ComboBox x:Name="WorkspacesBox" Header="Workspaces shown as" Width="240"
                                          HorizontalAlignment="Left" />
                                <ComboBox x:Name="ClockFormatBox" Header="Clock" Width="240" HorizontalAlignment="Left" />
                                <ToggleSwitch x:Name="SecondsSwitch" Header="Seconds in the clock"
                                              OnContent="On" OffContent="Off" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- step 3: behaviour -->
                    <StackPanel x:Name="PageBehaviour" Spacing="14" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Control" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="HotkeysSwitch" Header="Global hotkeys"
                                              OnContent="Ctrl+Alt+D, Ctrl+Alt+Space, Ctrl+Alt+C"
                                              OffContent="Off" />
                                <ToggleSwitch x:Name="OsdSwitch" Header="Show overlays when volume, brightness or microphone change"
                                              OnContent="On" OffContent="Off" />
                                <ToggleSwitch x:Name="UpdateSwitch" Header="Check for updates in the background"
                                              OnContent="On" OffContent="Off" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Notifications" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="MirrorSwitch" Header="Mirror Windows notifications into the shell"
                                              OnContent="Mirror" OffContent="Off" />
                                <ToggleSwitch x:Name="DndSwitch" Header="Start with Do not disturb"
                                              OnContent="On" OffContent="Off" />
                                <Slider x:Name="TimeoutSlider" Header="Toast timeout (seconds)" Minimum="2" Maximum="20"
                                        StepFrequency="1" Width="320" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Where everything lives" FontWeight="SemiBold" />
                                <TextBlock x:Name="PathsText" FontSize="11" Opacity="0.7"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- footer -->
        <Grid Grid.Row="2" Margin="28,12,28,22" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="QuitButton" Content="Quit without starting" Click="OnQuit" />
            <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="11" Opacity="0.7"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button x:Name="BackButton" Grid.Column="2" Content="Back" Click="OnBack" />
            <Button x:Name="NextButton" Grid.Column="3" Content="Next" Style="{ThemeResource AccentButtonStyle}"
                    Click="OnNext" />
        </Grid>
    </Grid>
</Window>
