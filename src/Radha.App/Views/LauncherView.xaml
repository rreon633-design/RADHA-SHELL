<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Radha.App.Views.LauncherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{Binding State.Theme.SurfaceGlassStrong}"
            BorderBrush="{Binding State.Theme.OutlineVariant}" BorderThickness="1"
            CornerRadius="28" Padding="14">
        <StackPanel Spacing="10">

            <!-- search field -->
            <Border Background="{Binding State.Theme.SurfaceContainerHigh}" CornerRadius="16" Padding="12,2">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search apps, or type > for commands…"
                             Background="Transparent" BorderThickness="0" FontSize="16" Height="48"
                             KeyDown="OnSearchKeyDown" TextChanged="OnSearchChanged" />
                    <TextBlock Grid.Column="2" Text="ESC" FontSize="9" VerticalAlignment="Center"
                               Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                </Grid>
            </Border>

            <!-- live calculator result -->
            <Border Background="{Binding State.Theme.PrimaryContainer}" CornerRadius="14" Padding="12,8"
                    Visibility="{Binding HasCalculation, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="=" FontSize="13" Foreground="{Binding State.Theme.OnPrimaryContainer}" />
                    <TextBlock Text="{Binding Calculation}" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Foreground="{Binding State.Theme.OnPrimaryContainer}" />
                </Grid>
            </Border>

            <!-- results -->
            <ListView ItemsSource="{Binding Results}" MaxHeight="380" IsItemClickEnabled="True"
                      ItemClick="OnItemClick" SelectionMode="None"
                      Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="11"
                                    Background="{Binding IconBackground}">
                                <FontIcon Glyph="{Binding Glyph}" FontSize="15"
                                          Foreground="{Binding IconForeground}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding NameBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="9"
                                           Foreground="{Binding SubtitleBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="↵" FontSize="10" Opacity="0.5"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- footer -->
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="↵ open" FontSize="9" Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                    <TextBlock Text="> commands" FontSize="9" Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                    <TextBlock Text="esc close" FontSize="9" Foreground="{Binding State.Theme.OnSurfaceVariant}" />
                </StackPanel>
                <TextBlock Text="{Binding Query}" FontSize="9" HorizontalAlignment="Right"
                           Foreground="{Binding State.Theme.Primary}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
