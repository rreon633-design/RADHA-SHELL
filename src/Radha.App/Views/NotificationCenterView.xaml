<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Radha.App.Views.NotificationCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{Binding Theme.SurfaceGlass}" BorderBrush="{Binding Theme.OutlineVariant}"
            BorderThickness="1" CornerRadius="28" Padding="14">
        <StackPanel Spacing="10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold"
                               Foreground="{Binding Theme.OnSurface}" />
                    <TextBlock Text="Windows toast mirror" FontSize="9"
                               Foreground="{Binding Theme.OnSurfaceVariant}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Width="30" Height="30" Padding="0" CornerRadius="10" BorderThickness="0"
                            Background="{Binding Theme.SurfaceContainerHigh}"
                            Command="{Binding ToggleDndCommand}" ToolTipService.ToolTip="Do not disturb">
                        <FontIcon Glyph="&#xE7ED;" FontSize="12" Foreground="{Binding Theme.OnSurfaceVariant}" />
                    </Button>
                    <Button Width="30" Height="30" Padding="0" CornerRadius="10" BorderThickness="0"
                            Background="{Binding Theme.SurfaceContainerHigh}"
                            Command="{Binding ClearNotificationsCommand}" ToolTipService.ToolTip="Clear all">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{Binding Theme.OnSurfaceVariant}" />
                    </Button>
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Notifications}" MaxHeight="460">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding CardBrush}" CornerRadius="16" Padding="11" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="7" Background="{Binding AccentBrush}">
                                        <FontIcon Glyph="&#xEA8F;" FontSize="11" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppName}" FontSize="8.5" Opacity="0.7"
                                                   Foreground="{Binding AppNameBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding TitleBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="8.5" Opacity="0.6"
                                               Foreground="{Binding TitleBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding Body}" FontSize="9.5" TextWrapping="Wrap" MaxLines="3"
                                           Foreground="{Binding BodyBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <ItemsControl ItemsSource="{Binding Actions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}" FontSize="9.5" Padding="9,3"
                                                        CornerRadius="8" BorderThickness="0"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Foreground="White"
                                                        Click="OnActionClick" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Dismiss" FontSize="9.5" Padding="9,3" CornerRadius="8"
                                            BorderThickness="0" Click="OnDismissClick"
                                            Background="{Binding CardBrush}" Foreground="{Binding BodyBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="You're all caught up." FontSize="10" HorizontalAlignment="Center" Margin="0,20"
                       Foreground="{Binding Theme.OnSurfaceVariant}"
                       Visibility="{Binding HasNotifications, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
