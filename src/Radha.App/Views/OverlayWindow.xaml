<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Radha.App.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Radha.App.Views">

    <Grid x:Name="Root">
        <!-- click-away scrim -->
        <Border x:Name="Scrim" Background="{Binding Theme.Scrim}" Opacity="0.38"
                Tapped="OnScrimTapped" />

        <Grid Width="1180" MaxHeight="560" VerticalAlignment="Top" Margin="0,56,0,0"
              Visibility="{Binding IsDashboardOpen, Converter={StaticResource BoolToVisibility}}">
            <views:DashboardView x:Name="Dashboard" />
        </Grid>

        <Grid Width="760" MaxHeight="620" VerticalAlignment="Top" Margin="0,80,0,0"
              Visibility="{Binding IsLauncherOpen, Converter={StaticResource BoolToVisibility}}">
            <views:LauncherView x:Name="Launcher" />
        </Grid>

        <Grid Width="380" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,12,0"
              Visibility="{Binding IsControlCenterOpen, Converter={StaticResource BoolToVisibility}}">
            <views:ControlCenterView x:Name="ControlCenter" />
        </Grid>

        <Grid Width="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,56,0,0"
              Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BoolToVisibility}}">
            <views:NotificationCenterView x:Name="NotificationCenter" />
        </Grid>

        <Grid Width="360" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0"
              Visibility="{Binding IsSessionOpen, Converter={StaticResource BoolToVisibility}}">
            <views:SessionMenuView x:Name="SessionMenu" />
        </Grid>
    </Grid>
</Window>
