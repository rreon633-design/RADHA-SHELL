<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Radha.App.Views.SessionMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{Binding Theme.SurfaceGlass}" BorderBrush="{Binding Theme.OutlineVariant}"
            BorderThickness="1" CornerRadius="26" Padding="16">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Theme.AccentGradient}">
                    <TextBlock Text="{Binding UserName}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{Binding Theme.OnPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{Binding Theme.OnSurface}" />
                    <TextBlock Text="{Binding UptimeText}" FontSize="9"
                               Foreground="{Binding Theme.OnSurfaceVariant}" />
                </StackPanel>
            </StackPanel>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Click="OnLogout" Margin="3" Padding="12" CornerRadius="14" BorderThickness="0"
                        Background="{Binding Theme.SurfaceContainerHigh}" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{Binding Theme.Primary}" />
                        <TextBlock Text="Sign out" FontSize="10.5" Foreground="{Binding Theme.OnSurface}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Click="OnSuspend" Margin="3" Padding="12" CornerRadius="14" BorderThickness="0"
                        Background="{Binding Theme.SurfaceContainerHigh}" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE708;" FontSize="15" Foreground="{Binding Theme.Primary}" />
                        <TextBlock Text="Sleep" FontSize="10.5" Foreground="{Binding Theme.OnSurface}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Click="OnReboot" Margin="3" Padding="12" CornerRadius="14" BorderThickness="0"
                        Background="{Binding Theme.SurfaceContainerHigh}" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE777;" FontSize="15" Foreground="{Binding Theme.Primary}" />
                        <TextBlock Text="Restart" FontSize="10.5" Foreground="{Binding Theme.OnSurface}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Click="OnShutdown" Margin="3" Padding="12" CornerRadius="14" BorderThickness="0"
                        Background="{Binding Theme.SurfaceContainerHigh}" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE7E8;" FontSize="15" Foreground="{Binding Theme.Error}" />
                        <TextBlock Text="Shut down" FontSize="10.5" Foreground="{Binding Theme.OnSurface}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="0" Click="OnHibernate" Margin="3" Padding="12" CornerRadius="14" BorderThickness="0"
                        Background="{Binding Theme.SurfaceContainerHigh}" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7A6;" FontSize="15" Foreground="{Binding Theme.Primary}" />
                        <TextBlock Text="Hibernate" FontSize="10.5" Foreground="{Binding Theme.OnSurface}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Stopping the shell is its own action, separate from the session ones: it
                     leaves Windows running and ends only RADHA SHELL. -->
                <Button Grid.Row="2" Grid.Column="1" Click="OnQuitShell" Margin="3" Padding="12" CornerRadius="14"
                        BorderThickness="0" Background="{Binding Theme.SurfaceContainerHigh}"
                        HorizontalContentAlignment="Left" ToolTipService.ToolTip="Stop RADHA SHELL">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71A;" FontSize="15" Foreground="{Binding Theme.Error}" />
                        <TextBlock Text="Quit shell" FontSize="10.5" Foreground="{Binding Theme.OnSurface}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock x:Name="ConfirmText" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{Binding Theme.Error}" />
        </StackPanel>
    </Border>
</UserControl>
