<Project Sdk="Microsoft.NET.Sdk">

  <!-- Type-checks every line of Radha.App C# against the real WinUI/WinRT reference assemblies.
       The WinUI XAML compiler (XamlCompiler.exe) is a Windows-only binary, so this project
       compiles the .cs files with generated stubs for XAML-created members instead of the XAML.
       Output is a library: it exists purely to prove the C# compiles. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <AssemblyName>Radha.App.TypeCheck</AssemblyName>
    <RootNamespace>Radha.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWinUI>false</UseWinUI>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <!-- PRI/MSIX packaging tasks only exist on Windows and are irrelevant to a type check. -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <Platform>x64</Platform>
    <NoWarn>$(NoWarn);CS8618;CS0169;CS0649;CS0067;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Radha.App\**\*.cs" Exclude="..\..\src\Radha.App\bin\**;..\..\src\Radha.App\obj\**" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Radha.Core\Radha.Core.csproj" />
  </ItemGroup>

  <!-- The XAML compiler is Windows-only, so we synthesise InitializeComponent() + x:Name fields
       from the markup before compiling. Items are added here (not at evaluation time) so a fresh
       clone works even though generated/ is git-ignored. -->
  <Target Name="GenerateXamlStubs" BeforeTargets="CoreCompile" Condition="'$(SkipXamlStubs)' != 'true'">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)generate-stubs.py&quot; &quot;$(MSBuildThisFileDirectory)../..&quot; &quot;$(MSBuildThisFileDirectory)generated&quot;"
          StandardOutputImportance="low" />
    <ItemGroup>
      <Compile Include="$(MSBuildThisFileDirectory)generated/*.g.cs" />
    </ItemGroup>
  </Target>

</Project>
