<Project Sdk="Microsoft.NET.Sdk">

  <!-- Static verifier for the WinUI 3 layer. Runs on any OS so CI can check the XAML
       without a Windows runner; the Windows job remains the authoritative compile. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>XamlAudit</RootNamespace>
    <AssemblyName>xaml-audit</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
